# PostgreSQL connection string. Use a managed PostgreSQL provider in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/samarides?schema=public"
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial administrator. Set private values before running npm run db:seed.
ADMIN_NAME="Sama Rides Administrator"
ADMIN_PHONE="+254700000000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Provider credentials are deliberately blank until provider accounts are configured.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MAPS_API_KEY=""
